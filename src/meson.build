#*****************************************************************************
# meson.build (midi66)
#-----------------------------------------------------------------------------
##
# \file        src/meson.build
# \library     midi66
# \author      Chris Ahlstrom
# \date        2022-06-08
# \updates     2026-11-13
# \license     $XPC_SUITE_GPL_LICENSE$
#
#  This file is part of the "midi66" library. See the top-level meson.build
#  file for license information.
#
#  Here we locate the library source-code files.  They reside in:
#
#     -  src. The main include directory, currently nothing needed there.
#     -  src/midi. Contains code adapted from the Seq66 project.
#
#-----------------------------------------------------------------------------

libmidi66_sources += files(
   'midi/calculations.cpp',
   'midi/clocking.cpp',
   'midi/controllers.cpp',
   'midi/drums.cpp',
   'midi/editable_event.cpp',
   'midi/editable_events.cpp',
   'midi/event.cpp',
   'midi/eventcodes.cpp',
   'midi/eventlist.cpp',
   'midi/eventspecs.cpp',
   'midi/file.cpp',
   'midi/filebase.cpp',
   'midi/macro.cpp',
   'midi/macros.cpp',
   'midi/message.cpp',
   'midi/midibytes.cpp',
   'midi/patches.cpp',
   'midi/rpn.cpp',
   'midi/scales.cpp',
   'midi/song.cpp',
   'midi/splitter.cpp',
   'midi/track.cpp',
   'midi/trackdata.cpp',
   'midi/trackinfo.cpp',
   'midi/tracklist.cpp',
   'midi/transcript.cpp'
   )

#****************************************************************************
# meson.build (src/midi66)
#----------------------------------------------------------------------------
# vim: ts=3 sw=3 ft=meson
#----------------------------------------------------------------------------
